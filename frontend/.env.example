# Copy to frontend/.env.local and fill in the real values.
# The contract address is written here automatically by `npm run deploy`.

# Network the DApp connects to (must match the wallet's selected network).
VITE_NETWORK=preview

# Address of the deployed Private Crowdfunding contract.
# Fill in after `npm run deploy -- --network preview` (it is saved to
# .env.local automatically).
VITE_CONTRACT_ADDRESS=

# Preview indexer GraphQL endpoints (public state reads).
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
