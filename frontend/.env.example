# Copy to frontend/.env.local and fill in the real values.
# The contract address is written here automatically by `npm run deploy`.

# Network the DApp connects to (must match the wallet's selected network).
VITE_NETWORK=preprod

# Address of the deployed Crowdfunding-Midnight contract.
# Fill in after browser deployment on /deploy or contract deployment
VITE_CONTRACT_ADDRESS=

# Preprod indexer GraphQL endpoints (public state reads).
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
