# Contract artifacts (generated by `npm run compile`)
# contracts/managed/ is generated locally and NOT committed.
# The copies in frontend/src/contracts + frontend/public/contracts ARE committed
# so Vercel can build the frontend without the Compact toolchain.
contracts/managed/
frontend/.env.local
frontend/dist/
frontend/node_modules/

# Deployment info
deployment.json

# Wallet seed + private state (SENSITIVE - never commit)
.midnight-state.json
.midnight-wallet-state/
midnight-level-db/
*.seed

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
